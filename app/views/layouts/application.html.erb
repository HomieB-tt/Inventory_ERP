<!DOCTYPE html>
<html>
  <head>
    <title>Inventory ERP</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <% if Current.user %>
      <div class="app-shell">
        <nav class="sidebar" aria-label="Primary">
          <div class="sidebar-brand"><%= Current.company&.name %></div>
          <ul class="sidebar-nav">
            <li><%= link_to "Dashboard", root_path %></li>
            <li><%= link_to "Products", products_path %></li>
            <li><%= link_to "Warehouses", warehouses_path %></li>
            <li><%= link_to "Suppliers", suppliers_path %></li>
            <li><%= link_to "Stock ledger", stock_movements_path %></li>
            <li><%= link_to "Transfers", stock_transfers_path %></li>
            <li><%= link_to "Purchase orders", purchase_orders_path %></li>
            <li><%= link_to "Sales orders", sales_orders_path %></li>
            <% if Current.user.at_least?(:admin) %>
              <li><%= link_to "Team", invitations_path %></li>
            <% end %>
          </ul>
        </nav>
        <div class="main-column">
          <header class="topbar">
            <span class="topbar-user"><%= Current.user.email_address %> · <%= Current.user.role %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: "link-button" %>
          </header>
          <main class="page">
            <% if notice %><p class="flash flash-notice"><%= notice %></p><% end %>
            <% if alert %><p class="flash flash-alert"><%= alert %></p><% end %>
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <main class="page page-unauthenticated">
        <% if notice %><p class="flash flash-notice"><%= notice %></p><% end %>
        <% if alert %><p class="flash flash-alert"><%= alert %></p><% end %>
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
