<div class="page-header">
  <h1>Stock transfers</h1>
  <% if Current.user.at_least?(:staff) %>
    <%= link_to "New transfer", new_stock_transfer_path, class: "btn" %>
  <% end %>
</div>

<% if @transfers.any? %>
  <table>
    <thead><tr><th>When</th><th>Product</th><th>From</th><th>To</th><th>Qty</th><th>By</th></tr></thead>
    <tbody>
      <% @transfers.each do |t| %>
        <tr>
          <td><%= t.created_at.strftime("%b %-d, %Y %H:%M") %></td>
          <td><%= link_to t.product.name, t.product %></td>
          <td><%= t.from_warehouse.name %></td>
          <td><%= t.to_warehouse.name %></td>
          <td class="qty"><%= t.quantity %></td>
          <td><%= t.user.email_address %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state">No transfers yet.
    <% if Current.user.at_least?(:staff) %><%= link_to "Create the first one", new_stock_transfer_path %>.<% end %>
  </p>
<% end %>
