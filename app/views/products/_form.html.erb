<%= form_with model: product do |f| %>
  <% if product.errors.any? %>
    <div class="error-list">
      <% product.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :sku %>
    <%= f.text_field :sku %>
  </div>
  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>
  <div class="field">
    <%= f.label :category %>
    <%= f.text_field :category %>
  </div>
  <div class="field">
    <%= f.label :description %>
    <%= f.text_area :description %>
  </div>
  <div class="field">
    <%= f.label :unit_price %>
    <%= f.number_field :unit_price, step: 0.01, min: 0 %>
  </div>
  <div class="field">
    <%= f.label :reorder_threshold %>
    <%= f.number_field :reorder_threshold, min: 0 %>
  </div>

  <%= f.submit %>
<% end %>
