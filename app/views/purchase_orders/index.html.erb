<div class="page-header">
  <h1>Purchase orders</h1>
  <% if Current.user.at_least?(:staff) %>
    <%= link_to "New purchase order", new_purchase_order_path, class: "btn" %>
  <% end %>
</div>

<% if @purchase_orders.any? %>
  <table>
    <thead><tr><th>Date</th><th>Supplier</th><th>Status</th><th>Total</th></tr></thead>
    <tbody>
      <% @purchase_orders.each do |po| %>
        <tr>
          <td><%= link_to po.order_date, po %></td>
          <td><%= po.supplier.name %></td>
          <td><span class="badge"><%= po.status %></span></td>
          <td class="num"><%= number_to_currency(po.total_cost) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state">No purchase orders yet.
    <% if Current.user.at_least?(:staff) %><%= link_to "Create the first one", new_purchase_order_path %>.<% end %>
  </p>
<% end %>
