<div class="page-header">
  <h1><%= @supplier.name %></h1>
  <div>
    <% if Current.user.at_least?(:staff) %>
      <%= link_to "Edit", edit_supplier_path(@supplier), class: "btn" %>
    <% end %>
    <% if Current.user.at_least?(:admin) %>
      <%= button_to "Delete", @supplier, method: :delete, class: "btn-danger",
            form: { data: { turbo_confirm: "Delete this supplier?" } } %>
    <% end %>
  </div>
</div>

<table>
  <tbody>
    <tr><td>Contact email</td><td><%= @supplier.contact_email.presence || "Not set" %></td></tr>
    <tr><td>Phone</td><td><%= @supplier.phone.presence || "Not set" %></td></tr>
    <tr><td>Address</td><td><%= @supplier.address.presence || "Not set" %></td></tr>
  </tbody>
</table>

<h2>Purchase orders</h2>
<% if @supplier.purchase_orders.any? %>
  <table>
    <thead><tr><th>Date</th><th>Status</th><th>Total</th></tr></thead>
    <tbody>
      <% @supplier.purchase_orders.order(order_date: :desc).each do |po| %>
        <tr>
          <td><%= link_to po.order_date, po %></td>
          <td><span class="badge"><%= po.status %></span></td>
          <td class="num"><%= number_to_currency(po.total_cost) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty-state">No purchase orders from this supplier yet.</p>
<% end %>
