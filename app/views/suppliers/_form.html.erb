<%= form_with model: supplier do |f| %>
  <% if supplier.errors.any? %>
    <div class="error-list">
      <% supplier.errors.full_messages.each do |msg| %><p><%= msg %></p><% end %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>
  <div class="field">
    <%= f.label :contact_email %>
    <%= f.email_field :contact_email %>
  </div>
  <div class="field">
    <%= f.label :phone %>
    <%= f.text_field :phone %>
  </div>
  <div class="field">
    <%= f.label :address %>
    <%= f.text_area :address %>
  </div>

  <%= f.submit %>
<% end %>
